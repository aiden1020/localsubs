{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "localsubs-site",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/app-router-entry",
  "assets": {
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "localsubs.aidenw.me",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
